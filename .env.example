# Runtime environment: development, test, or production.
NODE_ENV=development
# Local interfaces and ports exposed by each application.
WEB_HOST=0.0.0.0
WEB_PORT=3000
API_HOST=0.0.0.0
API_PORT=3001
# PostgreSQL connection used exclusively by the API/database package.
DATABASE_URL=postgresql://matemyparty:matemyparty@localhost:5432/matemyparty
# Server-only API origin used by Next.js. Never expose this value through NEXT_PUBLIC_*.
INTERNAL_API_BASE_URL=http://localhost:3001
# Reported by GET /health.
APP_VERSION=0.1.0
# Internationalization defaults and allow-list.
DEFAULT_LOCALE=en-US
SUPPORTED_LOCALES=en-US,es-MX
# Public fallback hostname. Keep localhost:3000 for development; use matemyparty.domoforge.com in production.
PRIMARY_APP_HOSTNAME=localhost:3000
# Temporary host API secret. Replace this development-only value with at least 32 random characters.
# Production startup refuses missing, short, or known example values. Never expose it as NEXT_PUBLIC_*.
HOST_ADMIN_TOKEN=local-development-host-token-change-me-2026
# Public invitation URL scheme. Use https in production.
PUBLIC_APP_PROTOCOL=http
# Add non-personal sample guests during seed only when explicitly enabled.
SEED_SAMPLE_GUESTS=false
