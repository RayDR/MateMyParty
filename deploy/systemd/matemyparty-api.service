[Unit]
Description=MateMyParty NestJS API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=matemyparty
Group=matemyparty
WorkingDirectory=/opt/matemyparty
EnvironmentFile=/etc/matemyparty/matemyparty.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env pnpm --filter @matemyparty/api start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=matemyparty-api
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
