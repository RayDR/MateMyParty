{
  "name": "matemyparty",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm packages:build && turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "packages:build": "pnpm --filter './packages/**' build",
    "db:generate": "pnpm --filter @matemyparty/database db:generate",
    "db:migrate": "pnpm --filter @matemyparty/database db:migrate",
    "db:seed": "pnpm --filter @matemyparty/database db:seed",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "eslint": "9.39.2",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.4.0",
    "prettier": "3.6.2",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "typescript-eslint": "8.46.1"
  }
}
