# Copy to /etc/matemyparty/matemyparty.env on the VPS. Never commit the real file.
NODE_ENV=production
# Port 3000 is occupied by an unrelated VPS service; MateMyParty uses loopback port 3200.
WEB_HOST=127.0.0.1
WEB_PORT=3200
API_HOST=127.0.0.1
API_PORT=3201
DATABASE_URL=postgresql://matemyparty:REPLACE_WITH_DATABASE_PASSWORD@127.0.0.1:5432/matemyparty
# Server-only API origin used by Next.js. Browser host operations use relative /internal routes.
INTERNAL_API_BASE_URL=http://127.0.0.1:3201
APP_VERSION=0.1.0
DEFAULT_LOCALE=en-US
SUPPORTED_LOCALES=en-US,es-MX
PRIMARY_APP_HOSTNAME=matemyparty.domoforge.com
# Generate at deployment time with: openssl rand -base64 48
HOST_ADMIN_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PUBLIC_APP_PROTOCOL=https
SEED_SAMPLE_GUESTS=false
